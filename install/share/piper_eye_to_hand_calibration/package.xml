<?xml version="1.0"?>
<package format="2">
  <name>piper_eye_to_hand_calibration</name>
  <version>0.1.0</version>
  <description>ROS intrinsics, manual 5+1 stereo, Piper RS1 handeye and extrinsic composition.</description>

  <maintainer email="maintainer@example.com">Workspace Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>camera_calibration</exec_depend>
  <test_depend>python3-nose</test_depend>

  <export/>
</package>
